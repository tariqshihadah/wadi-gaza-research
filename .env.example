# Copernicus Data Space Ecosystem (CDSE) OAuth credentials
# Get these from: https://dataspace.copernicus.eu -> Dashboard -> OAuth clients
SH_CLIENT_ID=your-client-id-here
SH_CLIENT_SECRET=your-client-secret-here

# Copernicus Climate Data Store (ERA5-Land): credentials are NOT read from this file.
# Put them in ~/.cdsapirc (url: https://cds.climate.copernicus.eu/api, key: <token>).
